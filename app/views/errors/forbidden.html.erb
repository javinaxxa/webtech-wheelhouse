<% content_for :title, "Not allowed" %>

<div class="row justify-content-center">
  <div class="col-md-7">
    <div class="card border-danger">
      <div class="card-body">
        <h1 class="card-title h4">You are not allowed to do that</h1>

        <p class="card-text">
          Your account does not have permission for this page or this action. If you think it
          should, ask the owner of the shop to change your role.
        </p>

        <p class="card-text text-muted">
          Signed in as <%= Current.user&.display_name %>,
          <%= Current.user&.role&.humanize&.downcase %>.
        </p>

        <%= link_to "Back to the price list", services_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>
</div>
