<% content_for :title, "Sign in" %>

<div class="row justify-content-center">
  <div class="col-md-5">
    <h1 class="h3 mb-4">Sign in to Wheelhouse</h1>

    <%= form_with url: session_path do |f| %>
      <div class="mb-3">
        <%= f.label :email_address, "Email address", class: "form-label" %>
        <%= f.email_field :email_address, required: true, autofocus: true,
            autocomplete: "username", value: params[:email_address],
            class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :password, class: "form-label" %>
        <%= f.password_field :password, required: true, autocomplete: "current-password",
            maxlength: 72, class: "form-control" %>
      </div>

      <%= f.submit "Sign in", class: "btn btn-primary" %>
    <% end %>

    <hr class="my-4">

    <p class="mb-1">
      <%= link_to "I forgot my password", new_password_path %>
    </p>
    <p class="mb-0">
      New to the workshop? <%= link_to "Create an account", new_registration_path %>
    </p>
  </div>
</div>
