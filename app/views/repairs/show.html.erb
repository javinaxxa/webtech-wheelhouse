<% content_for :title, "Repair ##{@repair.id}" %>

<div class="card">
  <div class="card-body">
    <h1 class="card-title h4">
      Repair #<%= @repair.id %> <%= status_badge(@repair) %>
    </h1>

    <dl class="row mb-0 mt-3">
      <dt class="col-sm-3">Bike</dt>
      <dd class="col-sm-9">
        <%= link_to "#{@repair.bike.make} #{@repair.bike.model} (#{@repair.bike.serial_number})", @repair.bike %>
      </dd>

      <dt class="col-sm-3">Customer</dt>
      <dd class="col-sm-9">
        <%= link_to @repair.bike.customer.name, @repair.bike.customer %>
      </dd>

      <dt class="col-sm-3">Received by</dt>
      <dd class="col-sm-9"><%= link_to @repair.received_by.name, @repair.received_by %></dd>

      <dt class="col-sm-3">Mechanic</dt>
      <dd class="col-sm-9">
        <% if @repair.assigned_mechanic %>
          <%= link_to @repair.assigned_mechanic.name, @repair.assigned_mechanic %>
        <% else %>
          <span class="text-muted">Not assigned yet</span>
        <% end %>
      </dd>

      <dt class="col-sm-3">Dropped off</dt>
      <dd class="col-sm-9"><%= l(@repair.dropped_off_at, format: :long) %></dd>

      <dt class="col-sm-3">Promised</dt>
      <dd class="col-sm-9">
        <%= l(@repair.promised_on, format: :long) %>
        <% if @repair.overdue? %>
          <span class="badge text-bg-warning">Overdue</span>
        <% end %>
      </dd>

      <dt class="col-sm-3">Completed</dt>
      <dd class="col-sm-9">
        <%= @repair.completed_at ? l(@repair.completed_at, format: :long) : content_tag(:span, "Not yet", class: "text-muted") %>
      </dd>

      <dt class="col-sm-3">Picked up</dt>
      <dd class="col-sm-9">
        <%= @repair.picked_up_at ? l(@repair.picked_up_at, format: :long) : content_tag(:span, "Still in the shop", class: "text-muted") %>
      </dd>

      <dt class="col-sm-3">Customer approved</dt>
      <dd class="col-sm-9">
        <% if @repair.customer_approved.nil? %>
          <span class="text-muted">Not asked yet</span>
        <% else %>
          <%= @repair.customer_approved ? "Yes" : "No" %>
        <% end %>
      </dd>
    </dl>
  </div>
</div>

<h2 class="h5 mt-4">Diagnosis</h2>

<% if @repair.diagnosis.present? %>
  <div class="trix-content border rounded p-3"><%= @repair.diagnosis %></div>
<% else %>
  <p class="text-muted">No diagnosis written yet.</p>
<% end %>

<h2 class="h5 mt-4">
  <%= pluralize(@repair.intake_photos.size, "intake photo") %>
</h2>

<% if @repair.intake_photos.attached? %>
  <div class="row g-3">
    <% @repair.intake_photos.select { |photo| photo.persisted? && photo.variable? }.each do |photo| %>
      <div class="col-6 col-md-4">
        <figure class="figure">
          <%= link_to url_for(photo), target: "_blank", rel: "noopener" do %>
            <%= image_tag photo.variant(:medium),
                alt: "Intake photo of the #{@repair.bike.make} #{@repair.bike.model} for repair ##{@repair.id}",
                class: "figure-img img-fluid rounded" %>
          <% end %>
          <figcaption class="figure-caption">
            <%= button_to "Remove this photo",
                repair_intake_photo_path(@repair, photo),
                method: :delete,
                form_class: "d-inline",
                data: { turbo_confirm: "Remove this photo from repair ##{@repair.id}?" },
                class: "btn btn-sm btn-outline-danger" %>
          </figcaption>
        </figure>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-muted">No photos were taken when this bike came in.</p>
<% end %>

<h2 class="h5 mt-4"><%= pluralize(@lines.size, "service") %> charged</h2>

<% if @lines.empty? %>
  <p class="text-muted">Nothing charged on this repair yet.</p>
<% else %>
  <table class="table table-sm">
    <thead>
      <tr>
        <th>Service</th>
        <th>Note</th>
        <th class="text-end">Price charged</th>
      </tr>
    </thead>
    <tbody>
      <% @lines.each do |line| %>
        <tr>
          <td><%= link_to line.service_type.name, line.service_type %></td>
          <td><%= line.discount_note || "-" %></td>
          <td class="text-end"><%= money(line.price_charged) %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr class="fw-bold">
        <td colspan="2">Total</td>
        <td class="text-end"><%= money(@repair.total) %></td>
      </tr>
    </tfoot>
  </table>
<% end %>

<%= link_to "All repairs", repairs_path, class: "btn btn-outline-secondary mt-3" %>
<%= link_to "Edit", edit_repair_path(@repair), class: "btn btn-outline-primary mt-3" %>
<%= button_to "Delete", @repair, method: :delete,
    form_class: "d-inline",
    data: { turbo_confirm: "Delete repair ##{@repair.id}?" },
    class: "btn btn-outline-danger mt-3" %>
