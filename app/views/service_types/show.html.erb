<% content_for :title, @service_type.name %>

<div class="card">
  <div class="card-body">
    <h1 class="card-title h4"><%= @service_type.name %></h1>
    <p class="card-text fs-5"><%= money(@service_type.current_price) %></p>
  </div>
</div>

<h2 class="h5 mt-4">
  <%= pluralize(@service_type.repair_line_items.size, "time") %> charged
</h2>

<% if @service_type.repair_line_items.empty? %>
  <p class="text-muted">This service has never been charged on a repair.</p>
<% else %>
  <table class="table table-sm">
    <thead>
      <tr>
        <th>Repair</th>
        <th>Bike</th>
        <th class="text-end">Price charged</th>
      </tr>
    </thead>
    <tbody>
      <% @service_type.repair_line_items.each do |line| %>
        <tr>
          <td><%= link_to "Repair ##{line.repair.id}", line.repair %></td>
          <td><%= link_to "#{line.repair.bike.make} #{line.repair.bike.model}", line.repair.bike %></td>
          <td class="text-end"><%= money(line.price_charged) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<%= link_to "All services", services_path, class: "btn btn-outline-secondary mt-3" %>