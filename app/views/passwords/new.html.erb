<% content_for :title, "Forgot your password?" %>

<div class="row justify-content-center">
  <div class="col-md-5">
    <h1 class="h3 mb-4">Forgot your password?</h1>

    <p class="text-muted">
      Type the email address of your account. If it has one, a link to choose a new password
      goes out to it.
    </p>

    <%= form_with url: passwords_path do |f| %>
      <div class="mb-3">
        <%= f.label :email_address, "Email address", class: "form-label" %>
        <%= f.email_field :email_address, required: true, autofocus: true,
            autocomplete: "username", value: params[:email_address],
            class: "form-control" %>
      </div>

      <%= f.submit "Email me a link", class: "btn btn-primary" %>
      <%= link_to "Back to signing in", new_session_path, class: "btn btn-outline-secondary" %>
    <% end %>
  </div>
</div>
