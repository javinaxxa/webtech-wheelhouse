<%= form_with model: customer do |f| %>
  <% if customer.errors.any? %>
    <div class="alert alert-danger">
      <p class="mb-1 fw-bold"><%= pluralize(customer.errors.count, "problem") %> stopped this from being saved:</p>
      <ul class="mb-0">
        <% customer.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: ["form-control", { "is-invalid": customer.errors[:name].any? }] %>
    <div class="invalid-feedback"><%= customer.errors[:name].to_sentence %></div>
  </div>

  <div class="mb-3">
    <%= f.label :phone, class: "form-label" %>
    <%= f.text_field :phone, class: ["form-control", { "is-invalid": customer.errors[:phone].any? }] %>
    <div class="invalid-feedback"><%= customer.errors[:phone].to_sentence %></div>
  </div>

  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", customer.persisted? ? customer : customers_path, class: "btn btn-outline-secondary" %>
<% end %>
