<% content_for :title, "Services" %>

<h1 class="h3 mb-4">Services</h1>

<% if @service_types.empty? %>
  <p class="text-muted">No services on the price list yet.</p>
<% else %>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th>Service</th>
        <th class="text-end">Price</th>
      </tr>
    </thead>
    <tbody>
      <%= render @service_types %>
    </tbody>
  </table>
<% end %>