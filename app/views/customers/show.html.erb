<% content_for :title, @customer.name %>

<div class="card">
  <div class="card-body">
    <h1 class="card-title h4"><%= @customer.name %></h1>
    <p class="card-text text-muted"><%= @customer.phone %></p>
  </div>
</div>

<h2 class="h5 mt-4"><%= pluralize(@bikes.size, "bike") %></h2>

<% if @bikes.empty? %>
  <p class="text-muted">This customer has no bikes on file.</p>
<% else %>
  <table class="table table-sm align-middle">
    <thead>
      <tr>
        <th>Bike</th>
        <th>Colour</th>
        <th>Serial</th>
        <th>Owner</th>
        <th>Repairs</th>
      </tr>
    </thead>
    <tbody>
      <%= render @bikes %>
    </tbody>
  </table>
<% end %>

<%= link_to "All customers", customers_path, class: "btn btn-outline-secondary mt-3" %>
<%= link_to "Edit", edit_customer_path(@customer), class: "btn btn-outline-primary mt-3" %>
<%= link_to "Add a bike", new_bike_path(customer_id: @customer.id), class: "btn btn-outline-primary mt-3" %>
<%= button_to "Delete", @customer, method: :delete,
    form_class: "d-inline",
    data: { turbo_confirm: "Delete #{@customer.name} from the customer list?" },
    class: "btn btn-outline-danger mt-3" %>
