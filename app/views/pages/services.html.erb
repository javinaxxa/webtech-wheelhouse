<h1>Services &amp; prices</h1>

<p>The wall list every job we do, with what it costs today.</p>

<table class="table table-striped">
  <thead>
    <tr>
      <th scope="col">Service</th>
      <th scope="col" class="text-end">Price</th>
    </tr>
  </thead>
  <tbody>
    <% @services.each do |service| %>
      <tr>
        <td><%= service.name %></td>
        <td class="text-end">$<%= number_with_delimiter(service.current_price.to_i) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
