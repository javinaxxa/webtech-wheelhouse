<%= form_with model: bike do |f| %>
  <% if bike.errors.any? %>
    <div class="alert alert-danger">
      <p class="mb-1 fw-bold"><%= pluralize(bike.errors.count, "problem") %> stopped this from being saved:</p>
      <ul class="mb-0">
        <% bike.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :customer_id, "Owner", class: "form-label" %>
    <%= f.collection_select :customer_id, Customer.by_name, :id, :name,
        { prompt: "Choose the owner" },
        class: ["form-select", { "is-invalid": bike.errors[:customer].any? }] %>
    <div class="invalid-feedback"><%= bike.errors[:customer].to_sentence %></div>
  </div>

  <div class="mb-3">
    <%= f.label :make, class: "form-label" %>
    <%= f.text_field :make, class: ["form-control", { "is-invalid": bike.errors[:make].any? }] %>
    <div class="invalid-feedback"><%= bike.errors[:make].to_sentence %></div>
  </div>

  <div class="mb-3">
    <%= f.label :model, class: "form-label" %>
    <%= f.text_field :model, class: ["form-control", { "is-invalid": bike.errors[:model].any? }] %>
    <div class="invalid-feedback"><%= bike.errors[:model].to_sentence %></div>
  </div>

  <div class="mb-3">
    <%= f.label :color, "Colour", class: "form-label" %>
    <%= f.text_field :color, class: ["form-control", { "is-invalid": bike.errors[:color].any? }] %>
    <div class="invalid-feedback"><%= bike.errors[:color].to_sentence %></div>
  </div>

  <div class="mb-3">
    <%= f.label :serial_number, "Serial number", class: "form-label" %>
    <%= f.text_field :serial_number, class: ["form-control", { "is-invalid": bike.errors[:serial_number].any? }] %>
    <div class="invalid-feedback"><%= bike.errors[:serial_number].to_sentence %></div>
    <div class="form-text">Saved without spaces and in upper case.</div>
  </div>

  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", bike.persisted? ? bike : bikes_path, class: "btn btn-outline-secondary" %>
<% end %>
