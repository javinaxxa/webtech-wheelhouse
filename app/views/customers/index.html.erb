<% content_for :title, "Customers" %>

<h1 class="h3 mb-4">Customers</h1>

<% if @customers.empty? %>
  <p class="text-muted">No customers on file.</p>
<% else %>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th>Name</th>
        <th>Phone</th>
        <th>Bikes</th>
      </tr>
    </thead>
    <tbody>
      <%= render @customers %>
    </tbody>
  </table>
<% end %>
