<% content_for :title, @staff_member.name %>

<div class="card">
  <div class="card-body">
    <h1 class="card-title h4"><%= @staff_member.name %></h1>
    <p class="card-text text-muted"><%= @staff_member.role.humanize %></p>
  </div>
</div>

<h2 class="h5 mt-4"><%= pluralize(@assigned_repairs.size, "repair") %> assigned</h2>

<% if @assigned_repairs.empty? %>
  <p class="text-muted">No repairs assigned to this person.</p>
<% else %>
  <table class="table table-sm align-middle">
    <thead>
      <tr>
        <th>Bike</th>
        <th>Customer</th>
        <th>Status</th>
        <th>Promised</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <%= render @assigned_repairs %>
    </tbody>
  </table>
<% end %>

<h2 class="h5 mt-4"><%= pluralize(@received_repairs.size, "repair") %> received at the counter</h2>

<% if @received_repairs.empty? %>
  <p class="text-muted">This person has not received any repair.</p>
<% else %>
  <table class="table table-sm align-middle">
    <thead>
      <tr>
        <th>Bike</th>
        <th>Customer</th>
        <th>Status</th>
        <th>Promised</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <%= render @received_repairs %>
    </tbody>
  </table>
<% end %>

<%= link_to "All staff", staff_members_path, class: "btn btn-outline-secondary mt-3" %>
<%= link_to "Edit", edit_staff_member_path(@staff_member), class: "btn btn-outline-primary mt-3" %>
<%= button_to "Delete", @staff_member, method: :delete,
    form_class: "d-inline",
    data: { turbo_confirm: "Delete #{@staff_member.name} from the staff?" },
    class: "btn btn-outline-danger mt-3" %>
